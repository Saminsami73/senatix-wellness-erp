# ==============================================================================
# SENATIX WELLNESS ERP - VERCEL & SUPABASE ENVIRONMENT VARIABLES
# ==============================================================================
# 
# 1. LOCAL DEVELOPMENT:
#    Copy this file to `.env.local`:
#    cp .env.example .env.local
#
# 2. VERCEL DEPLOYMENT:
#    In your Vercel Project Dashboard -> Settings -> Environment Variables,
#    add these two variables for Production and Preview environments:
#
# Find your credentials in Supabase Dashboard:
# Project Settings (gear icon) -> API -> Project URL & Project API Keys (anon public)

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
